[Unit]
Description=UGREEN NAS leds status HTTP server
# Start after network is up so the TCP connection to ugreen_leds_server
# can be established.  The agent reconnects automatically if the server
# is not yet reachable, so a soft ordering dependency is enough.
After=network-online.target
Wants=network-online.target
# If Jellyfin itself runs as a local service in this LXC, you can
# uncomment the next line to ensure the LED agent starts after it:
# After=jellyfin.service

[Service]
Type=simple

ExecStart=/usr/local/bin/http_status_server --led-host 192.168.178.250 --assets-dir assets

Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# Logging goes to the journal by default.
# Add --verbose to ExecStart for debug-level output.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=http_status_server

# Run as a dedicated low-privilege user.
# Create it with: adduser --system --no-create-home http-status-server
User=http-status-server
Group=http-status-server

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
# Allow outbound TCP (LED server) and listening on the webhook port
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
