[Unit]
Description=VPN Gateway LED agent for UGREEN NAS (disk1 override)
Wants=network-online.target
After=network-online.target wg-quick@proton.service

[Service]
Type=simple
User=root
Environment=PYTHONUNBUFFERED=1
Environment=LED_HOST=192.168.178.250
Environment=LED_PORT=39001
Environment=LED_NAME=disk1
Environment=LED_PRIORITY=10
Environment=WG_INTERFACE=proton
Environment=WG_CONF=/etc/wireguard/proton.conf
EnvironmentFile=-/etc/vpn-led-agent.env
ExecStart=/usr/bin/python3 /usr/local/bin/vpn_lxc.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vpn-led-agent
UMask=0077

[Install]
WantedBy=multi-user.target
